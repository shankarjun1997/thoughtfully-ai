# Server-only DeepSeek (or any OpenAI-compatible) credentials. Never prefix with NEXT_PUBLIC_.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Optional: Supabase cloud persistence (not required for the local MVP).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Instagram link import
# Browserless screenshot API fallback when carousel slides cannot be fetched directly.
BROWSERLESS_TOKEN=
BROWSERLESS_URL=https://production-sfo.browserless.io

# Optional vision OCR. If unset, local Tesseract OCR is used.
VISION_API_KEY=
VISION_BASE_URL=https://api.openai.com/v1
VISION_MODEL=gpt-4o-mini

# Web push reminders (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Vercel cron authorization + server-side Supabase admin access
CRON_SECRET=
SUPABASE_SECRET_KEY=
# Optional alias accepted by the admin client.
SUPABASE_SERVICE_ROLE_KEY=

# Annual plan: 7-day trial, then one-time ₹200/year (Razorpay Orders).
# Set these to enable billing; when unset the app stays open and /subscribe shows "not configured".
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Consent-based session verification + admin alerts
# Admin inbox that receives new-device alerts and consented verification photos.
SECURITY_ALERT_EMAIL=
# Comma-separated allowlist for /admin/security. Falls back to SECURITY_ALERT_EMAIL.
SECURITY_ADMIN_EMAILS=
# Verified Resend sender, e.g. "Thoughtfully Security <security@yourdomain.com>".
SECURITY_ALERT_FROM=
RESEND_API_KEY=
# Set to "false" to hide the verification prompt. Device sign-in emails still send.
SESSION_VERIFICATION_ENABLED=true
# Set to "true" to block the workspace until the user completes verification.
SESSION_VERIFICATION_REQUIRED=false
# One-time confirmation email to the user after successful verification. Default true.
SECURITY_NOTIFY_USER=true
# HMAC secret for the signed httpOnly verification cookie. 32+ random chars.
# Falls back to SUPABASE_SECRET_KEY when unset.
SECURITY_SESSION_SECRET=
SESSION_VERIFICATION_RETENTION_DAYS=30
